load("@llvm-project//mlir:tblgen.bzl", "gentbl_filegroup", "td_library")
load("//bazel:prime_ir_cc.bzl", "prime_ir_cc_library")

package(
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "RingPyFiles",
    srcs = [
        "dialects/ring.py",
        ":RingPyGen",
    ],
)

filegroup(
    name = "RingPyApiFiles",
    srcs = ["RingModule.cpp"],
)

td_library(
    name = "RingPyTdFiles",
    deps = ["//prime_ir/Dialect/Ring/IR:td_files"],
)

gentbl_filegroup(
    name = "RingPyGen",
    tbl_outs = {"_ring_ops_gen.py": [
        "-gen-python-op-bindings",
        "-bind-dialect=ring",
    ]},
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "RingOps.td",
    deps = [":RingPyTdFiles"],
)

prime_ir_cc_library(
    name = "RingAttributesAndTypes",
    srcs = [
        "RingTypes.cpp",
    ],
    hdrs = [
        "RingTypes.h",
    ],
    deps = [
        "//prime_ir/Dialect/Ring/C:CAPI",
        "@llvm-project//mlir:CAPIIR",
        "@llvm-project//mlir:MLIRBindingsPythonCore",
        "@llvm-project//mlir:MLIRBindingsPythonHeadersAndDeps",
        "@nanobind",
    ],
)
