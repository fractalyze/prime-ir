load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")
load("//bazel:prime_ir_cc.bzl", "prime_ir_cc_library")

package(
    default_visibility = ["//visibility:public"],
)

prime_ir_cc_library(
    name = "Ring",
    srcs = [
        "RingDialect.cpp",
        "RingOps.cpp",
    ],
    hdrs = [
        "RingDialect.h",
        "RingEnums.h",
        "RingOps.h",
        "RingTypes.h",
    ],
    deps = [
        ":dialect_inc_gen",
        ":enums_inc_gen",
        ":ops_inc_gen",
        ":types_inc_gen",
        "//prime_ir/Dialect/Field/IR:Field",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:InferTypeOpInterface",
        "@llvm-project//mlir:SideEffectInterfaces",
        "@llvm-project//mlir:Support",
    ],
)

td_library(
    name = "td_files",
    srcs = [
        "RingDialect.td",
        "RingEnums.td",
        "RingOps.td",
        "RingTypes.td",
    ],
    includes = ["../../../.."],
    deps = [
        "@llvm-project//mlir:AttrTdFiles",
        "@llvm-project//mlir:BuiltinDialectTdFiles",
        "@llvm-project//mlir:InferTypeOpInterfaceTdFiles",
        "@llvm-project//mlir:OpBaseTdFiles",
        "@llvm-project//mlir:SideEffectInterfacesTdFiles",
    ],
)

gentbl_cc_library(
    name = "dialect_inc_gen",
    tbl_outs = {
        "RingDialect.h.inc": ["-gen-dialect-decls"],
        "RingDialect.cpp.inc": ["-gen-dialect-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "RingDialect.td",
    deps = [
        ":td_files",
    ],
)

gentbl_cc_library(
    name = "enums_inc_gen",
    tbl_outs = {
        "RingEnums.h.inc": ["-gen-enum-decls"],
        "RingEnums.cpp.inc": ["-gen-enum-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "RingEnums.td",
    deps = [
        ":td_files",
    ],
)

gentbl_cc_library(
    name = "types_inc_gen",
    tbl_outs = {
        "RingTypes.h.inc": [
            "-gen-typedef-decls",
            "--typedefs-dialect=ring",
        ],
        "RingTypes.cpp.inc": [
            "-gen-typedef-defs",
            "--typedefs-dialect=ring",
        ],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "RingTypes.td",
    deps = [
        ":td_files",
    ],
)

gentbl_cc_library(
    name = "ops_inc_gen",
    tbl_outs = {
        "RingOps.h.inc": ["-gen-op-decls"],
        "RingOps.cpp.inc": ["-gen-op-defs"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "RingOps.td",
    deps = [
        ":td_files",
    ],
)
