load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library")
load("//bazel:prime_ir_cc.bzl", "prime_ir_cc_library")

package(
    default_visibility = ["//visibility:public"],
)

prime_ir_cc_library(
    name = "RingToModArith",
    srcs = ["RingToModArith.cpp"],
    hdrs = ["RingToModArith.h"],
    deps = [
        ":pass_inc_gen",
        "//prime_ir/Dialect/Field/IR:Field",
        "//prime_ir/Dialect/ModArith/IR:ModArith",
        "//prime_ir/Dialect/Ring/IR:Ring",
        "//prime_ir/Utils:APIntUtils",
        "//prime_ir/Utils:ConversionUtils",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:LinalgDialect",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:TensorDialect",
        "@llvm-project//mlir:TransformUtils",
    ],
)

gentbl_cc_library(
    name = "pass_inc_gen",
    tbl_outs = {
        "RingToModArith.h.inc": [
            "-gen-pass-decls",
            "-name=RingToModArith",
        ],
        "RingToModArith.md": ["-gen-pass-doc"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "RingToModArith.td",
    deps = [
        "@llvm-project//mlir:PassBaseTdFiles",
    ],
)
