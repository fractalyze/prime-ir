"""PrimeIR as a Bazel module.

This is the only path the build resolves through, and it is what a consumer
gets when it declares a `bazel_dep` on prime_ir. Repositories are declared here
either as a `bazel_dep` or by a module extension wrapping a `.bzl` under
`//third_party` or `//bazel`; those `.bzl` files are also loaded directly by
consumers that still resolve through their own WORKSPACE, so a dependency
declared by one has to keep working for both.

Nothing here may carry a patch or a `single_version_override`. Bazel applies
both only for the root module, so a consumer would silently resolve the
unpatched dependency. The patched LLVM is safe because its patches hang off an
`http_archive` inside a module extension, which runs identically for every root
module — see `//bazel:llvm_deps.bzl`.

`archive_override` is root-only for the same reason, so a consumer of prime_ir
has to repeat the zk_dtypes override below alongside its own override of
prime_ir: neither fork is in a registry, and a non-root module cannot pull a
dependency in from outside one. `//bazel/bzlmod_consumer` is a worked example.
"""

module(
    # Tracks the repository's release tags; bump both together.
    name = "prime_ir",
    version = "2.0.0",
)

# Repo names match the ones the loader `.bzl` files declare, so that a
# first-party BUILD file reads the same whether it is built here or reached
# through a consumer's WORKSPACE. Every version that deviates from what those
# files pin is noted at the dependency.
bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.13")
bazel_dep(name = "rules_python", version = "1.6.0")
bazel_dep(name = "abseil-cpp", version = "20250814.0", repo_name = "com_google_absl")
bazel_dep(name = "googletest", version = "1.17.0", repo_name = "com_google_googletest")

# Not loaded by any first-party file. LLVM's Bazel overlay loads `sh_binary`
# from it, and `@llvm-project` is a module-extension repository, so it resolves
# `@rules_shell` through *this* module's mapping — which only a `bazel_dep`
# here puts it in.
bazel_dep(name = "rules_shell", version = "0.2.0")

# Not in any registry, so a `bazel_dep` alone cannot resolve it. The override
# pins the same archive `//third_party/zk_dtypes:workspace.bzl` fetches for
# WORKSPACE-mode consumers. MODULE.bazel cannot `load()`, so that pin cannot be
# shared and is spelled out again here, as it is a third time in
# `//bazel/bzlmod_consumer/MODULE.bazel`. The copies are held together from both
# ends — `//third_party/zk_dtypes:pin_sync_test` fails if these two drift, and
# `.github/workflows/pin-bump.yml` lists all three files so an automated bump
# moves them in one commit. The prefixed variable names are what let that
# substitution find the pin in each file, so keep this shape.
#
# `archive_override` takes `integrity` and not the `sha256` the loader's
# `http_archive` takes: the same digest, base64 rather than hex. `pin_sync_test`
# converts between the two before comparing.
ZK_DTYPES_COMMIT = "a45ddd0782891028191f429614912c314811acaa"

ZK_DTYPES_INTEGRITY = "sha256-3wm9QGTJBfQcCxoke4mvIZhmPEVG/gcAxXNbHMOfScU="

bazel_dep(name = "zk_dtypes", version = "0.0.17")
archive_override(
    module_name = "zk_dtypes",
    integrity = ZK_DTYPES_INTEGRITY,
    strip_prefix = "zk_dtypes-" + ZK_DTYPES_COMMIT,
    urls = ["https://github.com/fractalyze/zk_dtypes/archive/{commit}/zk_dtypes-{commit}.tar.gz".format(commit = ZK_DTYPES_COMMIT)],
)

# `bazel_features`, `rules_java` and `rules_cuda` have no `bazel_dep`. Version
# resolution does its own ordering, rules_python brings its own Java support in,
# no first-party file loads from any of the three, and no rule in this repository
# is a CUDA rule for a CUDA toolchain to apply to. A first CUDA target needs a
# `bazel_dep` plus a `register_toolchains` here, not just the archive.

non_module_deps = use_extension("//bazel:non_module_deps.bzl", "non_module_deps")
use_repo(
    non_module_deps,
    "local_config_omp",
    "nanobind",
    "pybind11",
    "robin_map",
)

llvm_deps = use_extension("//bazel:llvm_deps.bzl", "llvm_deps")
use_repo(llvm_deps, "llvm-raw", "llvm_zlib", "llvm_zstd")

# Second, and after the `use_repo` above: this extension's `.bzl` loads out of
# `@llvm-raw`, so that repository has to be in this module's mapping first.
llvm_project = use_extension("//bazel:llvm_configure.bzl", "llvm_project")
use_repo(llvm_project, "llvm-project")

dev_deps = use_extension("//bazel:dev_deps.bzl", "dev_deps", dev_dependency = True)
use_repo(dev_deps, "hedron_compile_commands")

# A WORKSPACE-mode consumer reaches hermetic Python through zk_dtypes'
# `python_init_*` macros, which wrap these same rules_python extensions and add
# `@python_version_repo`. Only `//third_party/rules_pywrap:pywrap.default.bzl`
# loads that repository, and nothing loads *it* — it is a `bzl_library` source
# and nothing more — so this build does without it. Its sibling
# `pywrap.impl.bzl` is loaded for real, by `//prime_ir:pywrap.bzl`.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "prime_ir_pypi",
    python_version = "3.11",
    requirements_lock = "//:requirements_lock_3_11.txt",
)

# The hub cannot be named `pypi` outright: rules_python keys hubs across the
# whole module graph and rejects a second one by the same name ("Duplicate
# cross-module pip hub named 'pypi'"), which zk_dtypes already declares.
# Aliasing here keeps the `@pypi` labels in first-party BUILD files reading the
# same as the name a WORKSPACE-mode consumer resolves.
use_repo(pip, pypi = "prime_ir_pypi")
